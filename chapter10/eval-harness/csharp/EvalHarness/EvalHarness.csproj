<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.8.3" />
    <!-- Only used when OPENAI_API_KEY is set; the default scripted model needs no key. -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="ModelContextProtocol" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The server under test lives in the same solution; the harness hosts its tool
         classes in-process rather than launching the executable. -->
    <ProjectReference Include="..\DocsServer\DocsServer.csproj" />
  </ItemGroup>

</Project>
