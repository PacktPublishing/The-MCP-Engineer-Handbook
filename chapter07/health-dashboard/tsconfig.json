{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    // ext-apps 1.7.5 ships .d.ts files with extensionless relative imports,
    // which NodeNext resolution rejects; skipLibCheck is required.
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["src/view"]
}
