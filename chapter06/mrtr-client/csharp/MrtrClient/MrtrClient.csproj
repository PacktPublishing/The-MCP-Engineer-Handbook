<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- MCP9001: a client host must still RENDER the deprecated plain-enum
         schema form when an older server sends it, so InputHandler matches
         on LegacyTitledEnumSchema deliberately. -->
    <NoWarn>$(NoWarn);MCPEXP001;MCP9001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.0.0" />
  </ItemGroup>

</Project>
